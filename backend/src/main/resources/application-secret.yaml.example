# Copy to src/main/resources/application-secret.yaml (gitignored).
# Loaded automatically via spring.config.import in application.yaml (no profile needed).
# Or set equivalent SPRING_DATASOURCE_* / FLYWAY_* environment variables.
# Supabase project: pgp-key-manager (ref: vwjmyednpakdcunrtyog)
# Dashboard: Project Settings → Database → Connection string

spring:
  datasource:
    # prepareThreshold=0 is required for PgBouncer transaction pooling (port 6543).
    url: jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&prepareThreshold=0
    username: postgres.vwjmyednpakdcunrtyog
    password: YOUR_DATABASE_PASSWORD
  flyway:
    url: jdbc:postgresql://db.vwjmyednpakdcunrtyog.supabase.co:5432/postgres
    user: postgres
    password: YOUR_DATABASE_PASSWORD

# Optional — non-blank issuer-uri enables JWT resource server (see Auth0ResourceServerConfig)
# app:
#   auth0:
#     issuer-uri: https://YOUR_TENANT.auth0.com/
#     audience: https://your-api-audience
