# Copy to `.env.local` (gitignored) and adjust values.

# Spring Boot API (browser calls this origin; CORS must allow this SPA origin)
VITE_API_BASE_URL=http://localhost:8080

# Auth0 SPA — optional until you configure a tenant
# API audience must have "Allow Offline Access" enabled for refresh tokens.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
