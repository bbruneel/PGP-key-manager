# Copy to docker/.env (gitignored) and adjust values.
# Used by: docker compose -f docker/compose.yml up --build

# Postgres (container-internal defaults match these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Backend — docker Spring profile runs Flyway from scratch on fresh Postgres
CORS_ALLOWED_ORIGINS=http://localhost

# Auth0 — required for /api/keys/** (optional for /api/hello health check only)
# Add http://localhost to Auth0 Allowed Callback URLs, Logout URLs, and Web Origins.
AUTH0_ISSUER_URI=
AUTH0_AUDIENCE=

# Frontend build args (baked into the static bundle at image build time)
# Leave VITE_API_BASE_URL empty when nginx proxies /api on the same origin.
VITE_API_BASE_URL=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
